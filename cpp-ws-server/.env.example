# 이 파일을 .env로 복사 후 실제 값 입력
# cp cpp-ws-server/.env.example cpp-ws-server/.env

# ── 서버 설정 ─────────────────────────────────────────────────────
PORT=9090
SPRING_URL=http://localhost:8080

# ── STT: RTZR WebSocket ───────────────────────────────────────────
# 발급: https://developers.rtzr.ai/console
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=
RTZR_SAMPLE_RATE=16000
