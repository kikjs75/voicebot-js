# 이 파일을 .env로 복사 후 실제 값 입력
# cp .env.example .env

# Spring Profile (sim | real)
SPRING_PROFILE=sim

# 시뮬레이터 URL (sim profile 시 사용)
STT_URL=http://stt-simulator:8081
LLM_URL=http://llm-simulator:8082
TTS_URL=http://tts-simulator:8083

# real profile — RTZR WebSocket STT
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=

# real-grpc profile — CLOVA Speech gRPC STT (선택)
CLOVA_SPEECH_SECRET_KEY=

# 공통 — CLOVA Voice TTS
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=

# 공통 — Anthropic Claude LLM
ANTHROPIC_API_KEY=
