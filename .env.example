# 이 파일을 .env로 복사 후 실제 값 입력
# cp .env.example .env

# Spring Profile (sim | real)
SPRING_PROFILE=sim

# 시뮬레이터 URL (sim profile 시 사용)
STT_URL=http://stt-simulator:8081
LLM_URL=http://llm-simulator:8082
TTS_URL=http://tts-simulator:8083

# ── STT: RTZR WebSocket (real profile) ────────────────────────────
# 발급: https://developers.rtzr.ai/console
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=

# ── TTS: Google Cloud TTS (real profile) ──────────────────────────
# 서비스 계정 JSON 키 파일 경로 (API 키 방식은 동작 안 함)
# 발급 방법: docs/GCP-TTS-SETUP.md 참조
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-key.json

# ── LLM: Anthropic Claude (real profile) ──────────────────────────
# 발급: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
