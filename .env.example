# 이 파일을 .env로 복사 후 실제 값 입력
# cp .env.example .env

# Spring Profile (sim | real)
SPRING_PROFILE=sim

# 시뮬레이터 URL (sim profile 시 사용)
# 로컬 개발(devcontainer): localhost 사용
# Docker Compose 전체 실행: Docker 서비스명 사용
STT_URL=http://localhost:8081
LLM_URL=http://localhost:8082
TTS_URL=http://localhost:8083

# real profile — RTZR WebSocket STT
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=

# real-grpc profile — CLOVA Speech gRPC STT (선택)
CLOVA_SPEECH_SECRET_KEY=

# 공통 — CLOVA Voice TTS (real / real-grpc profile)
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=

# Google Cloud TTS (real-google profile, PoC 무료 대안)
# 서비스 계정 JSON 키 파일 경로 (API 키 방식은 TTS에서 동작 안 함)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-key.json

# 공통 — Anthropic Claude LLM
ANTHROPIC_API_KEY=
